{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js?__url=/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?__url=/api/$1"
    }
  ]
}
